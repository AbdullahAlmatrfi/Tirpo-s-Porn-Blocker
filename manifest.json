{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "css": [
            "search_shield.css"
         ],
         "include_globs": [
            "*://*/*search*",
            "*://*/*images/search*",
            "*://*/*?q=*",
            "*://*/*&q=*",
            "*://*/*?query=*",
            "*://*/*&query=*",
            "*://*/*?text=*",
            "*://*/*&text=*",
            "*://*/*?p=*",
            "*://*/*&p=*",
            "*://*/*?wd=*",
            "*://*/*&wd=*",
            "*://*/*?k=*",
            "*://*/*&k=*",
            "*://*/*?keyword=*",
            "*://*/*&keyword=*",
            "*://*/*?search_query=*",
            "*://*/*&search_query=*",
            "*://*/*?searchterm=*",
            "*://*/*&searchterm=*"
         ],
         "js": [
            "search_shield.js"
         ],
         "matches": [
            "\u003Call_urls>"
         ],
         "run_at": "document_start"
      }
   ],
   "declarative_net_request": {
      "rule_resources": [
         {
            "enabled": true,
            "id": "keyword_interceptor",
            "path": "keyword_interceptor_rules.json"
         }
      ]
   },
   "description": "Tirpo's Porn Blocker blocks adult content, risky searches, and distracting sites with optional safe redirects.",
   "host_permissions": [
      "\u003Call_urls>"
   ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Tirpo's Porn Blocker",
   "permissions": [
      "storage",
      "declarativeNetRequest",
      "declarativeNetRequestFeedback",
      "notifications",
      "tabs",
      "webNavigation",
      "alarms"
   ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.6",
   "web_accessible_resources": [
      {
         "matches": [
            "\u003Call_urls>"
         ],
         "resources": [
            "blocked.html",
            "blocked.js",
            "sites.js",
            "onboarding.html",
            "vendor/clumsy-bird/*",
            "vendor/clumsy-bird/**/*"
         ]
      }
   ]
}